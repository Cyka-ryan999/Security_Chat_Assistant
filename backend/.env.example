# --- LLM provider ---
# Which client to use: "anthropic", "openai", "groq", "google", or
# "groq_google" (tries Groq first, auto-falls back to Google if Groq
# is rate-limited — recommended when using both free tiers together).
LLM_PROVIDER=groq_google

# Anthropic (requires billing/card after the small starter credit)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (requires billing/card)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq — free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (Gemini) — free tier, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash

# --- Storage paths ---
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_DB_PATH=./audit.db

# --- Auth for the audit/admin endpoints (demo only, replace for real use) ---
ADMIN_API_KEY=change-me-admin-key

# --- Retrieval settings ---
RETRIEVAL_TOP_K=4
EMBEDDING_MODEL=all-MiniLM-L6-v2
